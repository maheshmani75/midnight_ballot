pragma language_version >= 0.15;

import CompactStandardLibrary;

export ledger optionCount: Uint<8>;
export ledger tally: Map<Uint<8>, Counter>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger pollOpen: Boolean;

witness voterSecret(): Bytes<32>;
witness chosenOption(): Uint<8>;
constructor(numOptions: Uint<8>) {
  assert(numOptions > 0, "poll must have at least one option");
  assert(numOptions <= 32, "too many options");
  optionCount = disclose(numOptions);
  pollOpen = true;
}

export circuit castVote(): [] {
  assert(pollOpen, "poll is closed");

  const secret = voterSecret();
  const option = chosenOption();

  assert(option < optionCount, "invalid option index");

  const nullifier = persistentHash<Vector<2, Bytes<32>>>([pad(32, "null"), secret]);
  assert(!nullifiers.member(disclose(nullifier)), "this voter has already voted");
  nullifiers.insert(disclose(nullifier));

  const opt = disclose(option);
  if (!tally.member(opt)) {
    tally.insert(opt, default<Counter>);
  }
  tally.lookup(opt).increment(1);
}

export circuit closePoll(): [] {
  assert(pollOpen, "poll already closed");
  pollOpen = false;
}

// Trigger compile
